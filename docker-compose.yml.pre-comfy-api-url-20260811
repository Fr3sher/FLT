name: lora-dataset-studio

services:
  studio:
    build: .
    image: lora-dataset-studio
    container_name: "${COMPOSE_PROJECT_NAME:-lora-dataset-studio}"
    restart: unless-stopped
    network_mode: host
    deploy:
      resources:
        reservations:
          devices:
            - driver: nvidia
              device_ids: ["1"]
              capabilities: [gpu]
    labels:
      io.lora-dataset-studio.launch-mode: studio
    volumes:
      - /home/timo/ai-toolkit:/home/timo/ai-toolkit
      - /home/timo/ComfyUI:/home/timo/ComfyUI
      - ${LDS_DATA:-./data-docker}:/data
      - ./.env:/app/.env
    environment:
      - NVIDIA_VISIBLE_DEVICES=1
      - NVIDIA_DRIVER_CAPABILITIES=compute,utility
      - LDS_CONFIG=/data/config.json
      - LDS_HOST=0.0.0.0
      - LDS_PORT=5050
      - LDS_DOCKER_HAS_COMFYUI=1
      - LDS_COMFYUI_API_URL=http://localhost:8188
      - LDS_COMFYUI_BASE_DIR=/home/timo/ComfyUI
      - LDS_DOCKER_COMFY_MODE=external

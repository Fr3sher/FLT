  "experience": {
    "entrypoints": [
      {
        "label": "Improve dataset images",
        "path": "/datasets?section=images"
      },
      {
        "label": "Improve Bank images",
        "path": "/bank"
      },
      {
        "label": "Open settings",
        "path": "/plugins/image_upscale/settings?focus=klein-improve-settings"
      }
    ],
